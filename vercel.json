{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://analyticsbackend.vercel.app/api/:path*"
    },
    {
      "source": "/login/",
      "destination": "https://analyticsbackend.vercel.app/login/"
    },
    {
      "source": "/customer/:path*",
      "destination": "https://analyticsbackend.vercel.app/customer/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://analyticsbackend.vercel.app/admin/:path*"
    },
    {
      "source": "/django-admin/:path*",
      "destination": "https://analyticsbackend.vercel.app/django-admin/:path*"
    }
  ]
}
